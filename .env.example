# ── Required for all environments ────────────────────────────
# Supabase (already in .env)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Riman Fashion <orders@yourdomain.com>
RESEND_ADMIN_EMAIL=admin@yourdomain.com

# ── Error Monitoring (Sentry) ────────────────────────────────
SENTRY_DSN=https://xxxxx@o123456.ingest.sentry.io/123456

# ── Analytics (optional - can also set in admin panel) ────────
# GA4
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXX
# Plausible
PLAUSIBLE_DOMAIN=yourdomain.com

# ── Stripe (for checkout - you already have these) ──────────
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxx
VITE_STRIPE_CHECKOUT_ENDPOINT=https://your-project.supabase.co/functions/v1/create-checkout
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ── Bot protection (Cloudflare Turnstile, free) ────────────
# 1. dash.cloudflare.com → Turnstile → Add site → copy Site Key + Secret Key
# 2. Paste Site Key here, Secret Key into Supabase Auth → Captcha provider
# 3. Leave unset to keep login working exactly as today.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxx

# ── Admin second factor ────────────────────────────────────
# Enroll first at /admin (banner guides you), then set to 'true' to enforce.
VITE_REQUIRE_ADMIN_MFA=false