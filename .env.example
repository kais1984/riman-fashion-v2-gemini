# ============================================================================
# Riman Fashion — Environment Configuration
# Copy this file to `.env` and fill in the values.
# ============================================================================

# --- Supabase (REQUIRED — the app loads no data/auth without these) ---
# Source: Supabase dashboard → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Edge Function endpoints (recommended; app degrades without them) ---
# Deploy the functions first (see RESTORATION below), then paste each URL, e.g.
#   https://<project-ref>.functions.supabase.co/create-checkout
# If left empty the app falls back to client-side paths (weaker price
# verification, no notifications).
VITE_STRIPE_CHECKOUT_ENDPOINT=        # <- functions/create-checkout
VITE_CREATE_ORDER_ENDPOINT=           # <- functions/create-order  (server-trusted price verification)
VITE_NOTIFICATION_WEBHOOK=            # <- functions/send-notification

# ============================================================================
# SETUP RUNBOOK  (active project: vbuavhnpemnfsuguglqn — keys already in .env)
# The original project (qiccxnxtwbsreyfbqilw) was deleted; a NEW Supabase
# account/project (vbuavhnpemnfsuguglqn) is now live and reachable, and its
# client keys are already written into .env. Follow the remaining steps to
# stand up the database and Edge Functions.
# ----------------------------------------------------------------------------
# 1. (Done) Project vbuavhnpemnfsuguglqn created; VITE_SUPABASE_URL and
#      VITE_SUPABASE_ANON_KEY are set in .env. Confirm reachability:
#        nslookup vbuavhnpemnfsuguglqn.supabase.co   # must return an IP
# 2. Apply the schema (migrations/ folder, in filename order):
#      supabase login
#      supabase link --project-ref vbuavhnpemnfsuguglqn
#      supabase db push
# 3. Apply the schema (migrations/ folder, in filename order):
#      supabase link --project-ref <ref>
#      supabase db push
# 4. Set Edge Function secrets (Settings → Edge Functions → Secrets, or CLI):
#      supabase secrets set STRIPE_SECRET_KEY=... STRIPE_WEBHOOK_SECRET=... \
#        RESEND_API_KEY=... APP_URL=https://your-domain
#    (SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected automatically.)
# 5. Deploy the functions:
#      supabase functions deploy create-checkout
#      supabase functions deploy create-order
#      supabase functions deploy send-notification
#      supabase functions deploy stripe-webhook
# 6. Paste the deployed function URLs into the VITE_*_ENDPOINT vars above.
# 7. Verify from this machine — must return an IP, NOT "Non-existent domain":
#      nslookup <project-ref>.supabase.co
# 8. Restart the dev server (npm run dev). The console should stop showing
#    "[Riman] Network Error ... refresh_token".
# ============================================================================
